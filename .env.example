# Copy values into your shell or hosting settings, not into client JavaScript.
SITE_ORIGIN=https://bukiski-hram.org
BASE_PATH=
PRODUCTION=false
# envelope: documents inside noindex HTML pages (GitHub Pages).
# direct: plain PDF/DOC files with an X-Robots-Tag header (Apache).
DOCUMENT_DELIVERY=envelope
